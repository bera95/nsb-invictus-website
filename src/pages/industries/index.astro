---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import FinalCta from '../../components/cta/FinalCta.astro';
import { industries } from '../../data/industries';
import IconBadge from '../../components/ui/IconBadge.astro';
import { industryIcon } from '../../data/icons';
---
<Base title="Industries — Property Technology, E-commerce & Retail" description="Industry solutions from NSB INVICTUS, including property technology and digital real estate, and e-commerce and retail technology.">
  <PageHero
    eyebrow="Industries"
    title="Capabilities, <span class='text-gradient'>applied to your market.</span>"
    intro="Our capabilities apply across sectors. In selected industries we have shaped them into focused solutions that address the specific way those businesses operate."
    shape="building"
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Industries' }]}
  />
  <section class="py-16" aria-label="Industry verticals">
    <div class="container-x grid gap-5 lg:grid-cols-2">
      {industries.map((ind) => (
        <article class="panel group relative flex flex-col p-8 sm:p-10" data-reveal>
          <div class="flex items-center justify-between gap-4">
            <IconBadge name={industryIcon[ind.slug]} color="#22d3ee" size="lg" />
            {ind.flagship && <span class="tag !border-reality/60 !text-reality-soft">Flagship vertical</span>}
          </div>
          <h2 class="mt-6 text-2xl sm:text-3xl">{ind.name}</h2>
          <p class="mt-4 flex-1 leading-relaxed text-mist-400">{ind.summary}</p>
          <ul class="mt-6 grid gap-2 text-sm text-mist-200 sm:grid-cols-2">
            {ind.solutions.map((s) => <li class="flex gap-2"><span class="text-signal-soft">—</span>{s.title}</li>)}
          </ul>
          <a href={`/industries/${ind.slug}/`} class="mt-8 inline-flex items-center gap-2 text-signal-soft after:absolute after:inset-0">
            <span class="link-underline">Explore {ind.shortName}</span><span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
    <p class="container-x mt-10 text-mist-500">Working in another sector? Our capabilities are not limited to these verticals — <a href="/contact/" class="text-signal-soft link-underline">tell us about your context</a>.</p>
  </section>
  <FinalCta />
</Base>
