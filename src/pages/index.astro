---
import Base from '../layouts/Base.astro';
import ArchitectureCanvas from '../components/visual/ArchitectureCanvas.astro';
import Hero from '../components/home/Hero.astro';
import ServicesMarquee from '../components/home/ServicesMarquee.astro';
import FreeToolsTeaser from '../components/home/FreeToolsTeaser.astro';
import StatsStrip from '../components/home/StatsStrip.astro';
import AllServices from '../components/home/AllServices.astro';
import AgentWorkforce from '../components/home/AgentWorkforce.astro';
import LatestInsights from '../components/home/LatestInsights.astro';
import Problems from '../components/home/Problems.astro';
import CapabilityEcosystem from '../components/home/CapabilityEcosystem.astro';
import Advisory from '../components/home/Advisory.astro';
import PropTechSpotlight from '../components/home/PropTechSpotlight.astro';
import ProductsShowcase from '../components/home/ProductsShowcase.astro';
import Approach from '../components/home/Approach.astro';
import Principles from '../components/home/Principles.astro';
import FinalCta from '../components/cta/FinalCta.astro';
import { site } from '../data/site';

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: new URL('/', Astro.site).toString(),
};
---
<Base
  title="NSB INVICTUS — Where Vision Becomes Reality"
  rawTitle
  description="Websites, apps, SaaS, AI agents, SEO/AEO/GEO, content, social media, ads, analytics and security — one partner for your entire digital business, worldwide."
  jsonLd={website}
>
  <ArchitectureCanvas slot="backdrop" mode="scroll" sequence={['vision', 'architecture', 'ecosystem', 'building', 'architecture']} offset={1.9} zoom={1.12} lift={1.9} />
  <Hero />
  <ServicesMarquee />
  <StatsStrip />
  <AllServices />
  <Problems />
  <CapabilityEcosystem />
  <AgentWorkforce />
  <ProductsShowcase />
  <FreeToolsTeaser />
  <Advisory />
  <PropTechSpotlight />
  <Approach />
  <Principles />
  <LatestInsights />
  <FinalCta scene={4} />
</Base>
