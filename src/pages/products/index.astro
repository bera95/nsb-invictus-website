---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ProductGrid from '../../components/ui/ProductGrid.astro';
import FinalCta from '../../components/cta/FinalCta.astro';
---
<Base title="Proprietary Tools — SEODREAM & Analytics Command Center" description="NSB INVICTUS builds its own platforms: SEODREAM for SEO, AEO and GEO search intelligence, and a live analytics command center for GA4, GTM, Search Console and consent.">
  <PageHero
    compact
    eyebrow="Products"
    title="Tools we build <span class='text-gradient'>and own.</span>"
    intro="Our team develops its own software platforms for search intelligence and live analytics. They power our client work today — and more products are on the way. Every tool is shown with an honest status."
    shape="beacon"
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Products' }]}
  />
  <section class="py-12" aria-labelledby="portfolio-h">
    <div class="container-x"><h2 id="portfolio-h" class="sr-only">Product portfolio</h2><ProductGrid /></div>
  </section>
  <section class="py-16" aria-labelledby="sep-h">
    <div class="container-x grid gap-8 md:grid-cols-2">
      <div data-reveal>
        <h2 id="sep-h" class="text-2xl">Built for our own work first.</h2>
        <p class="mt-4 leading-relaxed text-mist-400">Our tools are developed independently from client engagements and used by our team to deliver deeper audits, continuous monitoring and faster fixes. Names and feature sets may evolve as the products mature.</p>
      </div>
      <div data-reveal>
        <h2 class="text-2xl">Interested in a partnership?</h2>
        <p class="mt-4 leading-relaxed text-mist-400">We welcome conversations with early adopters, pilot customers and distribution partners for products in development.</p>
        <a href="/contact/?topic=product" class="btn btn-ghost mt-6">Contact the product team</a>
      </div>
    </div>
  </section>
  <FinalCta />
</Base>
