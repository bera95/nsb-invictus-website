---
import Base from '../layouts/Base.astro';
import Arrow from '../components/ui/Arrow.astro';
---
<Base title="Page not found" description="The page you are looking for does not exist." noindex>
  <section class="flex min-h-[80svh] items-center pt-32">
    <div class="container-x">
      <p class="eyebrow mb-6">Error 404</p>
      <h1 class="text-display-lg">This structure <span class="text-gradient">hasn’t been built.</span></h1>
      <p class="mt-6 max-w-xl text-lg text-mist-400">The page you are looking for does not exist or has moved.</p>
      <div class="mt-10 flex flex-wrap gap-3"><a href="/" class="btn btn-primary">Back to home <Arrow /></a><a href="/contact/" class="btn btn-ghost">Contact us</a></div>
    </div>
  </section>
</Base>
