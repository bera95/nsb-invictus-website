---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import FinalCta from '../../components/cta/FinalCta.astro';
import Arrow from '../../components/ui/Arrow.astro';
import { capabilities, type Capability } from '../../data/capabilities';
import { industries } from '../../data/industries';
import { process } from '../../data/approach';

export function getStaticPaths() {
  return capabilities.map((c) => ({ params: { slug: c.slug }, props: { cap: c } }));
}
interface Props { cap: Capability }
const { cap } = Astro.props;
const related = cap.connections.map((c) => ({ ...c, cap: capabilities.find((x) => x.slug === c.to)! }));
const relevantIndustries = industries.filter((i) => i.solutions.some((s) => s.capability === cap.slug));
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: cap.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: cap.name,
  description: cap.seo.description,
  serviceType: cap.name,
  provider: { '@type': 'Organization', name: 'NSB INVICTUS', url: new URL('/', Astro.site).toString() },
  areaServed: ['Europe', 'United States', 'Canada', 'Worldwide'],
  hasOfferCatalog: { '@type': 'OfferCatalog', name: cap.name, itemListElement: cap.offerings.map((o) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: o.title, description: o.text } })) },
};
---
<Base title={cap.seo.title} description={cap.seo.description} jsonLd={[service, faqLd]}>
  <PageHero
    eyebrow={`Capability ${cap.index}`}
    title={cap.headline}
    intro={cap.intro}
    shape={cap.shape}
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Capabilities', href: '/capabilities/' }, { label: cap.name }]}
  >
    <a href={`/contact/?topic=${cap.slug}`} class="btn btn-primary">Discuss your {cap.shortName} project <Arrow /></a>
    <a href="#offerings" class="btn btn-ghost">What we deliver</a>
  </PageHero>

  <section class="relative py-20" aria-labelledby="problems-h">
    <div class="container-x grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div data-reveal>
        <p class="eyebrow mb-5">When to call us</p>
        <h2 id="problems-h" class="text-display-md">Signs you need {cap.shortName}.</h2>
      </div>
      <ul class="space-y-4">
        {cap.problems.map((p, i) => (
          <li class="flex gap-5 border-b border-line pb-5 text-lg text-mist-200" data-reveal data-reveal-delay={i * 70}>
            <span class="mt-1 font-mono text-xs text-signal-soft">0{i + 1}</span>{p}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="offerings" class="relative py-20" aria-labelledby="offer-h">
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow mb-5">What we deliver</p>
        <h2 id="offer-h" class="text-display-md">{cap.name}</h2>
      </div>
      <ul class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {cap.offerings.map((o, i) => (
          <li class="glass-card p-8" data-reveal data-reveal-delay={(i % 3) * 70}>
            <span class="block h-px w-8" style={`background:${cap.accent}`} aria-hidden="true"></span>
            <h3 class="mt-6 text-xl">{o.title}</h3>
            <p class="mt-3 leading-relaxed text-mist-400">{o.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative py-20" aria-labelledby="outcome-h">
    <div class="container-x grid gap-10 lg:grid-cols-2">
      <div class="panel p-8 sm:p-10" data-reveal>
        <p class="eyebrow mb-5">Outcomes we work towards</p>
        <h2 id="outcome-h" class="sr-only">Outcomes</h2>
        <ul class="space-y-4">
          {cap.outcomes.map((o) => (
            <li class="flex items-center gap-4 text-lg text-mist-50"><span class="h-1.5 w-1.5 rounded-full bg-reality shadow-[0_0_10px_#10b981]"></span>{o}</li>
          ))}
        </ul>
        <p class="mt-8 text-sm text-mist-500">Specific targets are agreed with each client during discovery and measured after launch.</p>
      </div>
      <div class="panel p-8 sm:p-10" data-reveal data-reveal-delay="80">
        <p class="eyebrow mb-5">How we deliver</p>
        <ol class="space-y-5">
          {process.map((s) => (
            <li class="flex gap-5">
              <span class="font-mono text-xs text-signal-soft">{s.n}</span>
              <div><p class="text-mist-50">{s.title}</p><p class="mt-1 text-sm text-mist-400">{s.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="relative py-20" aria-labelledby="related-h">
    <div class="container-x">
      <div data-reveal>
        <p class="eyebrow mb-5">Connected capabilities</p>
        <h2 id="related-h" class="text-3xl sm:text-4xl">Stronger together</h2>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((r) => (
          <li class="group relative rounded-2xl border border-line p-6 transition-colors hover:border-line-strong" data-reveal>
            <span class="h-2 w-2 rounded-full block" style={`background:${r.cap.accent}`}></span>
            <a href={`/capabilities/${r.cap.slug}/`} class="mt-5 block text-lg text-mist-50 after:absolute after:inset-0">{r.cap.name}</a>
            <p class="mt-2 text-sm text-mist-400">{r.label}</p>
          </li>
        ))}
      </ul>
      {relevantIndustries.length > 0 && (
        <p class="mt-10 text-mist-400">
          Applied in:{' '}
          {relevantIndustries.map((i, k) => (
            <>{k > 0 && ' · '}<a href={`/industries/${i.slug}/`} class="text-signal-soft link-underline">{i.shortName}</a></>
          ))}
        </p>
      )}
    </div>
  </section>

  <section class="relative py-20" aria-labelledby="faq-h">
    <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div data-reveal>
        <p class="eyebrow mb-5">FAQ</p>
        <h2 id="faq-h" class="text-display-md">Questions we hear about {cap.shortName}.</h2>
      </div>
      <div class="space-y-3">
        {cap.faq.map((f, i) => (
          <details class="faq panel group p-6" data-reveal data-reveal-delay={i * 80} open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg text-mist-50">
              <h3 class="text-lg">{f.q}</h3>
              <span class="faq-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-line-strong text-signal-soft transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-4 leading-relaxed text-mist-400">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <FinalCta title={`Let’s talk about <span class="text-gradient">${cap.shortName}</span>.`} topic={cap.slug} />
</Base>
