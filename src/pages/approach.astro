---
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import FinalCta from '../components/cta/FinalCta.astro';
import Arrow from '../components/ui/Arrow.astro';
import { process, engagementModels, principles, standards } from '../data/approach';
import { advisory } from '../data/capabilities';
---
<Base title="Approach — How We Work, Engagement Models & Standards" description="How NSB INVICTUS delivers: discovery, architecture, iterative engineering and continuous improvement — with engagement models for startups, SMEs and enterprises.">
  <PageHero
    eyebrow="Approach"
    title="Disciplined delivery, <span class='text-gradient'>from first idea to long-term operation.</span>"
    intro="Technology projects fail less often because of technology than because of unclear goals, hidden risk and poor communication. Our approach is designed to remove all three."
    shape="architecture"
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Approach' }]}
  />

  <section class="py-20" aria-labelledby="proc-h">
    <div class="container-x">
      <p class="eyebrow mb-5" data-reveal>Process</p>
      <h2 id="proc-h" class="text-display-md" data-reveal>Four phases. No black boxes.</h2>
      <ol class="mt-14 grid gap-5 md:grid-cols-2">
        {process.map((s, i) => (
          <li class="panel p-8" data-reveal data-reveal-delay={(i % 2) * 80}>
            <span class="font-mono text-sm text-signal-soft">{s.n}</span>
            <h3 class="mt-4 text-2xl">{s.title}</h3>
            <p class="mt-3 leading-relaxed text-mist-400">{s.text}</p>
            <ul class="mt-5 flex flex-wrap gap-2">{s.outputs.map((o) => <li class="tag">{o}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="advisory" class="py-20" aria-labelledby="adv-h">
    <div class="container-x">
      <div class="glass grid gap-10 rounded-3xl p-8 sm:p-12 lg:grid-cols-2" data-reveal>
        <div>
          <p class="eyebrow mb-5">Cross-cutting engagement</p>
          <h2 id="adv-h" class="text-display-md">{advisory.name}</h2>
          <p class="mt-6 leading-relaxed text-mist-400">{advisory.summary}</p>
          <p class="mt-4 leading-relaxed text-mist-400">Advisory can stand on its own — you keep the roadmap and architecture whether or not we build it — or it can become the first phase of delivery.</p>
          <a href="/contact/?topic=advisory" class="btn btn-primary mt-8">Book a discovery consultation <Arrow /></a>
        </div>
        <ol class="space-y-3 self-center">
          {advisory.steps.map((s, i) => (
            <li class="flex items-center gap-5 rounded-2xl border border-line bg-void/40 p-5"><span class="font-mono text-xs text-signal-soft">0{i + 1}</span><span class="text-mist-50">{s}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="py-20" aria-labelledby="models-h">
    <div class="container-x">
      <p class="eyebrow mb-5" data-reveal>Engagement models</p>
      <h2 id="models-h" class="text-display-md" data-reveal>From first MVP to enterprise programme.</h2>
      <ul class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-2 lg:grid-cols-4">
        {engagementModels.map((m) => (
          <li class="bg-ink-900 p-8" data-reveal>
            <h3 class="text-xl">{m.title}</h3>
            <p class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-signal-soft">{m.for}</p>
            <p class="mt-4 text-sm leading-relaxed text-mist-400">{m.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-20" aria-labelledby="std-h">
    <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div data-reveal>
        <p class="eyebrow mb-5">Technology</p>
        <h2 id="std-h" class="text-display-md">Proven tools, chosen per project.</h2>
        <p class="mt-6 leading-relaxed text-mist-400">We select technology for maintainability, security and fit — not novelty. These are typical choices; the right stack is agreed during architecture.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {standards.map((s) => (
          <div class="panel p-6" data-reveal>
            <h3 class="text-lg">{s.area}</h3>
            <ul class="mt-4 space-y-2 text-sm text-mist-400">{s.items.map((i) => <li>— {i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20" aria-labelledby="pr-h">
    <div class="container-x">
      <p class="eyebrow mb-5" data-reveal>Principles</p>
      <h2 id="pr-h" class="text-display-md" data-reveal>What you can expect from us.</h2>
      <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {principles.map((p) => (
          <li class="border-t border-line pt-6" data-reveal><h3 class="text-lg">{p.title}</h3><p class="mt-2 text-sm leading-relaxed text-mist-400">{p.text}</p></li>
        ))}
      </ul>
    </div>
  </section>
  <FinalCta />
</Base>
