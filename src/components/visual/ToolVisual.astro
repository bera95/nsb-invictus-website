---
/** Decorative, animated illustrations for the proprietary tools (not real data). */
interface Props { kind: 'radar' | 'pulse' }
const { kind } = Astro.props;
const blips = [[62, 30], [28, 58], [72, 70], [40, 22], [55, 82], [20, 36]];
const bars = [40, 65, 52, 80, 58, 90, 72, 60, 84, 70];
---
<div class="tool-visual relative aspect-[16/10] overflow-hidden rounded-xl border border-line bg-void/70" aria-hidden="true">
  <div class="absolute inset-0 grid-backdrop opacity-50"></div>
  {kind === 'radar' ? (
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="radar relative aspect-square h-[86%]">
        {[1, 2, 3, 4].map((k) => <span class="absolute rounded-full border border-neon/25" style={`inset:${(k - 1) * 12.5}%`}></span>)}
        <span class="absolute inset-x-0 top-1/2 h-px bg-neon/20"></span>
        <span class="absolute inset-y-0 left-1/2 w-px bg-neon/20"></span>
        <span class="sweep absolute inset-0 rounded-full"></span>
        {blips.map(([x, y], i) => <span class="blip absolute h-2 w-2 rounded-full" style={`left:${x}%;top:${y}%;animation-delay:${i * 0.55}s`}></span>)}
      </div>
      <div class="absolute left-4 top-4 font-mono text-[0.65rem] tracking-[0.2em] text-neon-soft">SEO · AEO · GEO</div>
      <div class="absolute bottom-4 right-4 font-mono text-[0.65rem] tracking-[0.2em] text-mist-500">SCANNING</div>
    </div>
  ) : (
    <div class="absolute inset-0 p-4">
      <div class="flex items-center justify-between font-mono text-[0.65rem] tracking-[0.2em]">
        <span class="text-signal-soft">GA4 · GTM · GSC · CONSENT</span>
        <span class="live flex items-center gap-2 text-reality-soft"><span class="h-1.5 w-1.5 rounded-full bg-reality"></span>LIVE</span>
      </div>
      <svg class="absolute inset-x-4 top-[22%] h-[42%] w-[calc(100%-2rem)]" viewBox="0 0 400 100" preserveAspectRatio="none">
        <defs><linearGradient id="pulse-g" x1="0" x2="1"><stop offset="0" stop-color="#7c5cff"/><stop offset=".5" stop-color="#ff4fd8"/><stop offset="1" stop-color="#22d3ee"/></linearGradient></defs>
        <path class="pulse-line" d="M0 70 L40 62 L70 66 L100 40 L130 48 L160 30 L190 52 L220 44 L250 20 L280 34 L310 26 L340 42 L370 18 L400 28" fill="none" stroke="url(#pulse-g)" stroke-width="2.5" vector-effect="non-scaling-stroke" />
        <path class="pulse-line ghost" d="M0 80 L40 76 L70 82 L100 66 L130 70 L160 58 L190 72 L220 64 L250 50 L280 60 L310 54 L340 64 L370 46 L400 52" fill="none" stroke="#22d3ee" stroke-opacity=".35" stroke-width="1.5" vector-effect="non-scaling-stroke" />
      </svg>
      <div class="absolute inset-x-4 bottom-4 flex h-[24%] items-end gap-1.5">
        {bars.map((h, i) => <span class="bar flex-1 rounded-t bg-gradient-to-t from-vision/60 to-signal/80" style={`height:${h}%;animation-delay:${i * 0.18}s`}></span>)}
      </div>
    </div>
  )}
</div>

<style>
  .sweep { background: conic-gradient(from 0deg, rgb(255 79 216 / 0.45), rgb(255 79 216 / 0) 70deg); }
  .blip { background: #ff4fd8; box-shadow: 0 0 12px #ff4fd8, 0 0 24px #ff4fd8; opacity: 0; }
  .pulse-line { stroke-dasharray: 900; stroke-dashoffset: 0; filter: drop-shadow(0 0 6px rgb(255 79 216 / 0.7)); }
  .live span { box-shadow: 0 0 10px #10b981; }
  :global(.motion-ok) .sweep { animation: sweep 3.2s linear infinite; }
  :global(.motion-ok) .blip { animation: blip 3.2s ease-out infinite; }
  :global(.motion-ok) .pulse-line { animation: draw 4s ease-in-out infinite; }
  :global(.motion-ok) .bar { animation: bar 1.8s ease-in-out infinite alternate; transform-origin: bottom; }
  :global(.motion-ok) .live span { animation: live 1.2s ease-in-out infinite; }
  @keyframes sweep { to { transform: rotate(360deg); } }
  @keyframes blip { 0%, 60% { opacity: 0; transform: scale(0.4); } 70% { opacity: 1; transform: scale(1.3); } 100% { opacity: 0; transform: scale(1); } }
  @keyframes draw { 0% { stroke-dashoffset: 900; } 60%, 100% { stroke-dashoffset: 0; } }
  @keyframes bar { to { transform: scaleY(0.55); } }
  @keyframes live { 50% { opacity: 0.2; } }
  @media (prefers-reduced-motion: reduce) { .blip { opacity: 1; } }
</style>
