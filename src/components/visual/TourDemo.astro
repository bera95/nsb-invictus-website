---
import Placeholder from '../ui/Placeholder.astro';
import { propertyTourDemo } from '../../data/industries';
const { panorama, title } = propertyTourDemo;
---
<div class="panel relative overflow-hidden" data-tour data-src={panorama}>
  <div class="relative aspect-[16/10] w-full bg-ink-900" data-tour-stage>
    <div class="absolute inset-0 grid-backdrop opacity-60" aria-hidden="true"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-5 p-6 text-center" data-tour-cover>
      <svg viewBox="0 0 64 64" class="h-14 w-14 text-signal-soft" fill="none" aria-hidden="true"><circle cx="32" cy="32" r="22" stroke="currentColor" stroke-width="1.2"/><ellipse cx="32" cy="32" rx="22" ry="8" stroke="currentColor" stroke-width="1.2"/><ellipse cx="32" cy="32" rx="8" ry="22" stroke="currentColor" stroke-width="1.2" opacity=".5"/></svg>
      <p class="font-display text-2xl text-mist-50">{title}</p>
      {panorama ? (
        <button type="button" class="btn btn-primary" data-tour-start>Start the 360° tour</button>
      ) : (
        <>
          <p class="max-w-md text-sm text-mist-400">The interactive viewer is ready. It activates as soon as a real property panorama is supplied.</p>
          <Placeholder label="property panorama (equirectangular image)" />
        </>
      )}
    </div>
  </div>
  <p class="border-t border-line px-6 py-4 text-xs text-mist-500">Drag, swipe or use the arrow keys to look around. Works in the browser on desktop and mobile — no app required.</p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-tour]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-tour-start]');
    btn?.addEventListener('click', async () => {
      const { createPanorama } = await import('../../scripts/panorama');
      root.querySelector('[data-tour-cover]')?.remove();
      createPanorama(root.querySelector<HTMLElement>('[data-tour-stage]')!, root.dataset.src!);
      (root.querySelector('canvas') as HTMLElement | null)?.focus();
    });
  });
</script>
