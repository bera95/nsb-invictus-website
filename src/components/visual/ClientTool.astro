---
/** Browser-only tools: UTM builder, word counter, password generator, image compressor. */
interface Props { kind: 'utm' | 'words' | 'password' | 'image' }
const { kind } = Astro.props;
const stat = (label: string, key: string) => ({ label, key });
const wordStats = [stat('Words', 'words'), stat('Characters', 'chars'), stat('No spaces', 'charsNoSpace'), stat('Sentences', 'sentences'), stat('Paragraphs', 'paragraphs'), stat('Reading time', 'read'), stat('Speaking time', 'speak'), stat('Readability', 'flesch')];
---
<div class="panel neon-frame p-6 sm:p-8" data-client-tool={kind}>
  {kind === 'utm' && (
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2"><label class="field-label" for="utm-url">Website URL *</label><input class="field" id="utm-url" name="url" placeholder="https://yourwebsite.com/landing-page" inputmode="url" /></div>
      <div><label class="field-label" for="utm-source">Campaign source * <span class="text-mist-500">(google, newsletter)</span></label><input class="field" id="utm-source" name="utm_source" /></div>
      <div><label class="field-label" for="utm-medium">Campaign medium * <span class="text-mist-500">(cpc, email, social)</span></label><input class="field" id="utm-medium" name="utm_medium" /></div>
      <div><label class="field-label" for="utm-campaign">Campaign name *</label><input class="field" id="utm-campaign" name="utm_campaign" /></div>
      <div><label class="field-label" for="utm-term">Campaign term</label><input class="field" id="utm-term" name="utm_term" /></div>
      <div class="sm:col-span-2"><label class="field-label" for="utm-content">Campaign content</label><input class="field" id="utm-content" name="utm_content" /></div>
      <div class="sm:col-span-2">
        <p class="field-label">Your campaign URL</p>
        <div class="flex flex-col gap-3 sm:flex-row"><output class="field block min-h-12 break-all font-mono text-sm text-signal-soft" data-utm-out>Fill in the required fields…</output><button type="button" class="btn btn-primary shrink-0" data-copy="[data-utm-out]">Copy</button></div>
      </div>
    </div>
  )}
  {kind === 'words' && (
    <div>
      <label class="field-label" for="wc-text">Your text</label>
      <textarea class="field min-h-56" id="wc-text" data-wc-text placeholder="Paste or type your text here…"></textarea>
      <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {wordStats.map((s) => <li class="glass-card p-4 text-center"><p class="font-display text-2xl text-gradient" data-wc={s.key}>0</p><p class="mt-1 text-xs text-mist-400">{s.label}</p></li>)}
      </ul>
      <p class="mt-6 field-label">Top keywords</p>
      <ul class="flex flex-wrap gap-2" data-wc-keywords><li class="text-sm text-mist-500">Start typing to see keyword density.</li></ul>
    </div>
  )}
  {kind === 'password' && (
    <div>
      <div class="flex flex-col gap-3 sm:flex-row"><output class="field block min-h-14 break-all font-mono text-lg text-mist-50" data-pw-out></output><button type="button" class="btn btn-primary shrink-0" data-copy="[data-pw-out]">Copy</button><button type="button" class="btn btn-ghost shrink-0" data-pw-new>New</button></div>
      <div class="mt-4 h-2 overflow-hidden rounded-full bg-white/5"><div class="h-full rounded-full transition-all duration-500" data-pw-bar></div></div>
      <p class="mt-2 text-sm" data-pw-strength></p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2"><label class="field-label" for="pw-len">Length: <span data-pw-len-val>20</span></label><input id="pw-len" type="range" min="8" max="64" value="20" class="w-full accent-[#ff4fd8]" data-pw-len /></div>
        {[['upper', 'Uppercase (A–Z)'], ['lower', 'Lowercase (a–z)'], ['digits', 'Numbers (0–9)'], ['symbols', 'Symbols (!@#…)']].map(([k, l]) => (
          <label class="flex items-center gap-3 text-sm text-mist-200"><input type="checkbox" checked class="h-4 w-4 accent-[#7c5cff]" data-pw-opt={k} />{l}</label>
        ))}
        <label class="flex items-center gap-3 text-sm text-mist-200 sm:col-span-2"><input type="checkbox" class="h-4 w-4 accent-[#7c5cff]" data-pw-opt="noambig" />Avoid look-alike characters (l, 1, O, 0)</label>
      </div>
    </div>
  )}
  {kind === 'image' && (
    <div>
      <label class="flex cursor-pointer flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-white/15 p-10 text-center transition-colors hover:border-neon/60" data-img-drop>
        <span class="text-4xl" aria-hidden="true">🖼️</span>
        <span class="text-mist-50">Choose an image or drop it here</span>
        <span class="text-xs text-mist-500">JPG, PNG or WebP · processed only in your browser</span>
        <input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-img-input />
      </label>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div><label class="field-label" for="img-w">Max width (px)</label><input class="field" id="img-w" type="number" min="50" max="8000" value="1600" data-img-w /></div>
        <div><label class="field-label" for="img-f">Format</label><select class="field" id="img-f" data-img-f><option value="image/webp">WebP (recommended)</option><option value="image/jpeg">JPEG</option></select></div>
        <div><label class="field-label" for="img-q">Quality: <span data-img-qv>80</span>%</label><input id="img-q" type="range" min="30" max="95" value="80" class="mt-3 w-full accent-[#ff4fd8]" data-img-q /></div>
      </div>
      <div class="mt-6 hidden" data-img-result>
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="glass-card p-4 text-center"><p class="font-display text-2xl text-mist-50" data-img-before>–</p><p class="text-xs text-mist-400">Original</p></div>
          <div class="glass-card p-4 text-center"><p class="font-display text-2xl text-gradient" data-img-after>–</p><p class="text-xs text-mist-400">Optimised</p></div>
          <div class="glass-card p-4 text-center"><p class="font-display text-2xl text-reality-soft" data-img-saved>–</p><p class="text-xs text-mist-400">Saved</p></div>
        </div>
        <img alt="Optimised preview" class="mt-4 max-h-72 w-full rounded-xl object-contain" data-img-preview />
        <a class="btn btn-primary mt-4" download="optimised.webp" data-img-download>Download optimised image</a>
      </div>
    </div>
  )}
</div>
