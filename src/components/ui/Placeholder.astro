---
/** Visible marker for content that requires client input. Toggle via site.showPlaceholders. */
import { site } from '../../data/site';
interface Props { label: string; class?: string }
const { label, class: cls = '' } = Astro.props;
---
{site.showPlaceholders && (
  <span class:list={['placeholder-note', cls]} data-placeholder>
    <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" aria-hidden="true"><path fill="currentColor" d="M8 1.5 15 14H1L8 1.5Zm-.75 4.5v4h1.5V6h-1.5Zm0 5v1.5h1.5V11h-1.5Z"/></svg>
    Input required: {label}
  </span>
)}
