---
/** Proprietary tools & products, driven by src/data/products.ts. */
import { products, productStatuses } from '../../data/products';
import ToolVisual from '../visual/ToolVisual.astro';
interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel: H = 'h3' } = Astro.props;
---
{products.length > 0 ? (
  <ul class="grid gap-6 lg:grid-cols-2">
    {products.map((p, i) => {
      const st = productStatuses[p.status];
      return (
        <li class="panel neon-frame flex flex-col p-6 sm:p-8" data-reveal data-reveal-delay={i * 120} data-tilt="4">
          {p.visual && <ToolVisual kind={p.visual} />}
          <div class="mt-7 flex flex-wrap items-center justify-between gap-3">
            <span class="font-mono text-xs uppercase tracking-[0.14em] text-mist-500">{p.category}</span>
            <span class="tag" style={`border-color:${st.tone};color:${st.tone};box-shadow:0 0 14px -4px ${st.tone}`}>{st.label}</span>
          </div>
          <H class="mt-4 text-3xl">{p.name}</H>
          <p class="mt-3 flex-1 leading-relaxed text-mist-400">{p.summary}</p>
          {p.features && (
            <ul class="mt-5 grid gap-2 text-sm text-mist-200 sm:grid-cols-2">
              {p.features.map((f) => <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-neon shadow-[0_0_8px_#ff4fd8]"></span>{f}</li>)}
            </ul>
          )}
          <div class="mt-6 flex flex-wrap items-center gap-4 text-sm">
            {p.url && <a href={p.url} rel="noopener" class="text-signal-soft link-underline">Visit product site ↗</a>}
            <a href={`/contact/?topic=product&product=${encodeURIComponent(p.slug)}`} class="text-signal-soft link-underline">
              {p.status === 'available' ? 'Request a demo' : 'Ask how we use it for you'} →
            </a>
            {p.workingName && <span class="text-xs text-mist-500">Working name — may change.</span>}
          </div>
        </li>
      );
    })}
  </ul>
) : (
  <div class="panel p-8"><p class="text-mist-400">Our first products are in development.</p></div>
)}
