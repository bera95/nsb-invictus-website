---
/** Product showcase driven by src/data/products.ts. Shows an honest empty state until products are added. */
import { products, productStatuses } from '../../data/products';
import Placeholder from './Placeholder.astro';
interface Props { compact?: boolean }
// `compact` is reserved for a condensed homepage variant.
const { compact: _compact = false } = Astro.props;
const statuses = Object.entries(productStatuses);
---
{products.length > 0 ? (
  <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {products.map((p) => {
      const st = productStatuses[p.status];
      return (
        <li class="panel flex flex-col p-7" data-reveal>
          <div class="flex items-center justify-between gap-3">
            <span class="font-mono text-xs uppercase tracking-[0.14em] text-mist-500">{p.category}</span>
            <span class="tag" style={`border-color:${st.tone};color:${st.tone}`}>{st.label}</span>
          </div>
          <h3 class="mt-6 text-2xl">{p.name}</h3>
          <p class="mt-3 flex-1 text-mist-400">{p.summary}</p>
          <div class="mt-6 flex flex-wrap gap-3 text-sm">
            {p.url && <a href={p.url} rel="noopener" class="text-signal-soft link-underline">Visit product site ↗</a>}
            <a href={`/contact/?topic=product&product=${encodeURIComponent(p.slug)}`} class="text-mist-200 link-underline">
              {p.status === 'available' ? 'Request a demo' : 'Register interest'}
            </a>
          </div>
        </li>
      );
    })}
  </ul>
) : (
  <div class="panel grid gap-10 p-8 sm:p-10 lg:grid-cols-[1.3fr_1fr]" data-reveal>
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-mist-500">Product lab</p>
      <h3 class="mt-4 text-2xl sm:text-3xl">Our first products are in development.</h3>
      <p class="mt-4 max-w-lg leading-relaxed text-mist-400">
        We will publish each product here as it reaches a public milestone, with a clear status label. If you would like early updates, register your interest.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a href="/contact/?topic=product" class="btn btn-ghost">Register interest</a>
        <Placeholder label="add products in src/data/products.ts" />
      </div>
    </div>
    {(
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-mist-500">Status labels</p>
        <ul class="mt-5 space-y-3">
          {statuses.map(([, s]) => (
            <li class="flex items-center justify-between gap-4 border-b border-line pb-3 text-sm">
              <span class="flex items-center gap-3 text-mist-50"><span class="h-2 w-2 rounded-full" style={`background:${s.tone}`}></span>{s.label}</span>
              <span class="text-right text-mist-500">{s.description}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
)}
