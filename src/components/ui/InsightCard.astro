---
import type { Insight } from '../../data/insights';
import { formatDate } from '../../data/insights';
interface Props { post: Insight; i?: number; headingLevel?: 'h2' | 'h3' }
const { post, i = 0, headingLevel: H = 'h3' } = Astro.props;
---
<li class="glass-card group relative flex flex-col p-6 sm:p-7" data-reveal data-reveal-delay={(i % 3) * 70} data-category={post.category}>
  <div class="flex flex-wrap items-center gap-2 text-xs">
    <span class="tag !border-neon/50 !text-neon-soft">{post.category}</span>
    <span class="text-mist-500">{post.readingMinutes} min read</span>
  </div>
  <H class="mt-5 text-xl leading-snug">{post.title}</H>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-mist-400">{post.description}</p>
  <div class="mt-6 flex items-center justify-between text-sm">
    <time class="text-mist-500" datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
    <a href={`/insights/${post.slug}/`} class="inline-flex items-center gap-2 text-signal-soft after:absolute after:inset-0"><span class="link-underline">Read article</span><span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></a>
  </div>
</li>
