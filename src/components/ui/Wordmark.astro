---
/**
 * NSB INVICTUS wordmark: a structure assembling from particles, followed by the name.
 */
interface Props { class?: string; showText?: boolean; id?: string }
const { class: cls = '', showText = true, id = 'wm' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-3', cls]}>
  <svg viewBox="0 0 32 32" class="h-8 w-8 shrink-0" aria-hidden="true" fill="none">
    <defs>
      <linearGradient id={`${id}-g`} x1="0" y1="32" x2="32" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#7c5cff" />
        <stop offset="0.55" stop-color="#22d3ee" />
        <stop offset="1" stop-color="#10b981" />
      </linearGradient>
    </defs>
    <circle cx="3.2" cy="23" r="1" fill="#7c5cff" opacity="0.5" />
    <circle cx="6.3" cy="17.5" r="1.2" fill="#8b6cff" opacity="0.75" />
    <circle cx="9.4" cy="12" r="1.4" fill="#a996ff" />
    <g stroke={`url(#${id}-g)`} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M13 28V10l8-5.5L29 10v18" />
      <path d="M21 4.5V28M13 16.5h16M13 22.5h16" opacity="0.8" />
    </g>
  </svg>
  {showText && (
    <span class="font-display leading-none text-mist-50 whitespace-nowrap">
      <span class="font-semibold tracking-[0.06em]">NSB</span>
      <span class="ml-1 font-light tracking-[0.3em] text-mist-200">INVICTUS</span>
    </span>
  )}
</span>
