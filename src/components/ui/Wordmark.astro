---
/**
 * NSB INVICTUS logo (light version for the dark site).
 * size: 'sm' header, 'md' default, 'lg' footer. showText=false renders only the N mark.
 */
interface Props { class?: string; showText?: boolean; id?: string; size?: 'sm' | 'md' | 'lg' }
const { class: cls = '', showText = true, size = 'sm' } = Astro.props;
const h = { sm: 40, md: 48, lg: 60 }[size];
const ratio = showText ? 640 / 214 : 256 / 282;
const w = Math.round(h * ratio);
const base = showText ? '/brand/logo-light' : '/brand/mark-light';
---
<picture class:list={['inline-flex shrink-0 items-center', cls]}>
  <source srcset={`${base}${showText ? '-sm' : ''}.webp 1x, ${base}.webp 2x`} type="image/webp" />
  <img src={`${base}.png`} alt="NSB INVICTUS" width={w} height={h} decoding="async" style={`height:${h}px;width:auto`} />
</picture>
