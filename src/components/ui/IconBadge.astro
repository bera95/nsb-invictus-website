---
/** Neon icon tile used across cards. */
import Icon from './Icon.astro';
import type { IconName } from '../../data/icons';
interface Props { name: IconName; color?: string; size?: 'sm' | 'md' | 'lg'; class?: string }
const { name, color = '#a996ff', size = 'md', class: cls = '' } = Astro.props;
const box = { sm: 'h-9 w-9 rounded-lg', md: 'h-12 w-12 rounded-xl', lg: 'h-16 w-16 rounded-2xl' }[size];
const ic = { sm: 'h-4 w-4', md: 'h-6 w-6', lg: 'h-8 w-8' }[size];
---
<span class:list={['icon-badge inline-flex shrink-0 items-center justify-center border', box, cls]} style={`color:${color};border-color:${color}55;background:${color}14;box-shadow:0 0 26px -8px ${color}, inset 0 1px 0 rgb(255 255 255 / 0.08)`}>
  <Icon name={name} class={ic} />
</span>
