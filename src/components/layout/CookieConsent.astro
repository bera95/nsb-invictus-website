---
/**
 * Cookie consent banner + Google Consent Mode v2 + Google Tag Manager.
 *
 * - Consent defaults to "denied" for every storage type before anything loads.
 * - GTM is loaded ONLY after the visitor grants analytics or marketing consent.
 * - The choice is stored in localStorage ("nsb-consent") for 12 months and can be
 *   changed at any time via any element with [data-cookie-settings].
 * - GA4 is configured inside GTM (Google tag with the G- measurement ID).
 */
import { site } from '../../data/site';
const gtmId = site.gtmId;
---
<script is:inline define:vars={{ gtmId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  window.gtag = gtag;
  gtag('consent', 'default', {
    ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
    analytics_storage: 'denied', functionality_storage: 'granted', security_storage: 'granted',
    wait_for_update: 500,
  });
  gtag('set', 'ads_data_redaction', true);
  gtag('set', 'url_passthrough', false);

  window.nsbLoadGTM = function () {
    if (window.__nsbGtmLoaded || !gtmId) return;
    window.__nsbGtmLoaded = true;
    dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
    document.head.appendChild(s);
  };
  window.nsbApplyConsent = function (c) {
    gtag('consent', 'update', {
      analytics_storage: c.analytics ? 'granted' : 'denied',
      ad_storage: c.marketing ? 'granted' : 'denied',
      ad_user_data: c.marketing ? 'granted' : 'denied',
      ad_personalization: c.marketing ? 'granted' : 'denied',
    });
    dataLayer.push({ event: 'consent_update', consent_analytics: !!c.analytics, consent_marketing: !!c.marketing });
    if (c.analytics || c.marketing) window.nsbLoadGTM();
  };
  try {
    var saved = JSON.parse(localStorage.getItem('nsb-consent') || 'null');
    if (saved && saved.v === 1 && Date.now() - saved.ts < 365 * 864e5) window.nsbApplyConsent(saved);
    else document.documentElement.classList.add('consent-pending');
  } catch (e) { document.documentElement.classList.add('consent-pending'); }
</script>

<div class="consent fixed inset-x-3 bottom-3 z-[70] mx-auto hidden max-w-3xl rounded-2xl p-5 shadow-2xl shadow-black/60 sm:inset-x-6 sm:bottom-6 sm:p-6" role="dialog" aria-modal="false" aria-labelledby="consent-title" aria-describedby="consent-desc" data-consent>
  <div class="flex flex-col gap-5">
    <div>
      <p id="consent-title" class="font-display text-lg text-mist-50">Your privacy, your choice</p>
      <p id="consent-desc" class="mt-2 text-sm leading-relaxed text-mist-400">
        We use optional cookies for analytics (Google Analytics via Google Tag Manager) to understand how the site is used and improve it. Nothing optional is loaded unless you agree. You can change your choice at any time. <a href="/privacy/#cookies" class="text-signal-soft underline underline-offset-4">Learn more about cookies</a>
      </p>
    </div>
    <div class="hidden space-y-3 border-t border-line pt-4" data-consent-details>
      <label class="flex items-start gap-3 text-sm">
        <input type="checkbox" checked disabled class="mt-1 h-4 w-4 accent-[#7c5cff]" />
        <span><span class="text-mist-50">Strictly necessary</span> <span class="text-mist-400">— security and remembering this choice. Always on.</span></span>
      </label>
      <label class="flex items-start gap-3 text-sm">
        <input type="checkbox" class="mt-1 h-4 w-4 accent-[#7c5cff]" data-consent-analytics />
        <span><span class="text-mist-50">Analytics</span> <span class="text-mist-400">— anonymous usage statistics (Google Analytics 4).</span></span>
      </label>
      <label class="flex items-start gap-3 text-sm">
        <input type="checkbox" class="mt-1 h-4 w-4 accent-[#7c5cff]" data-consent-marketing />
        <span><span class="text-mist-50">Marketing</span> <span class="text-mist-400">— measuring advertising campaigns. Currently not used.</span></span>
      </label>
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="btn btn-primary !min-h-10 !py-2.5" data-consent-accept>Accept all</button>
      <button type="button" class="btn btn-ghost !min-h-10 !py-2.5" data-consent-reject>Reject optional</button>
      <button type="button" class="btn btn-ghost !min-h-10 !py-2.5" data-consent-customize aria-expanded="false">Customise</button>
      <button type="button" class="btn btn-ghost hidden !min-h-10 !py-2.5" data-consent-save>Save choices</button>
    </div>
  </div>
</div>

<style>
  .consent { background: linear-gradient(180deg, rgb(16 22 40 / 0.98), rgb(8 11 20 / 0.98)); border: 1px solid rgb(255 79 216 / 0.35); box-shadow: 0 0 50px -18px rgb(255 79 216 / 0.6), 0 20px 60px -20px #000; }
  :global(.consent-pending) .consent { display: block; }
  .consent.is-open { display: block; }
  :global(.motion-ok) .consent { animation: consent-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.8s both; }
  @keyframes consent-in { from { opacity: 0; transform: translateY(20px); } }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-consent]')!;
  const details = box.querySelector<HTMLElement>('[data-consent-details]')!;
  const an = box.querySelector<HTMLInputElement>('[data-consent-analytics]')!;
  const mk = box.querySelector<HTMLInputElement>('[data-consent-marketing]')!;
  const save = box.querySelector<HTMLButtonElement>('[data-consent-save]')!;
  const customize = box.querySelector<HTMLButtonElement>('[data-consent-customize]')!;
  const w = window as any;

  const store = (analytics: boolean, marketing: boolean) => {
    const c = { v: 1, analytics, marketing, ts: Date.now() };
    try { localStorage.setItem('nsb-consent', JSON.stringify(c)); } catch {}
    w.nsbApplyConsent?.(c);
    document.documentElement.classList.remove('consent-pending');
    box.classList.remove('is-open');
  };
  box.querySelector('[data-consent-accept]')!.addEventListener('click', () => store(true, true));
  box.querySelector('[data-consent-reject]')!.addEventListener('click', () => store(false, false));
  save.addEventListener('click', () => store(an.checked, mk.checked));
  customize.addEventListener('click', () => {
    const open = details.classList.toggle('hidden') === false;
    customize.setAttribute('aria-expanded', String(open));
    save.classList.toggle('hidden', !open);
  });

  // Re-open from footer "Cookie settings"
  document.querySelectorAll('[data-cookie-settings]').forEach((el) =>
    el.addEventListener('click', () => {
      try {
        const saved = JSON.parse(localStorage.getItem('nsb-consent') || 'null');
        an.checked = !!saved?.analytics; mk.checked = !!saved?.marketing;
      } catch {}
      details.classList.remove('hidden');
      save.classList.remove('hidden');
      customize.setAttribute('aria-expanded', 'true');
      box.classList.add('is-open');
      box.querySelector<HTMLButtonElement>('[data-consent-save]')?.focus();
    }),
  );
</script>
