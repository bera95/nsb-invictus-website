---
import Wordmark from '../ui/Wordmark.astro';
import Arrow from '../ui/Arrow.astro';
import { navigation } from '../../data/site';
import { capabilities, advisory } from '../../data/capabilities';
import { industries } from '../../data/industries';
import Icon from '../ui/Icon.astro';
import { capabilityIcon, industryIcon, type IconName } from '../../data/icons';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
const menus: Record<string, { label: string; href: string; icon?: IconName }[]> = {
  '/capabilities/': [
    ...capabilities.map((c) => ({ label: c.name, href: `/capabilities/${c.slug}/`, icon: capabilityIcon[c.slug] })),
    { label: advisory.name, href: '/approach/#advisory', icon: 'compass' as IconName },
  ],
  '/industries/': industries.map((i) => ({ label: i.shortName, href: `/industries/${i.slug}/`, icon: industryIcon[i.slug] })),
};
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-500 border-b border-transparent" data-header>
  <div class="container-x flex h-[var(--header-h)] items-center justify-between gap-3 xl:gap-6">
    <a href="/" class="relative z-10 -m-1 p-1" aria-label="NSB INVICTUS — home">
      <Wordmark id="hdr" />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-0 xl:gap-1">
        {navigation.map((item) => {
          const sub = menus[item.href];
          return (
            <li class="group relative">
              <a
                href={item.href}
                class:list={['flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-2 text-[0.85rem] transition-colors xl:px-4 xl:text-[0.92rem]', isActive(item.href) ? 'text-mist-50' : 'text-mist-200 hover:text-mist-50']}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
                {(item.href === '/tools/' || item.href === '/ai-agents/') && <span class="h-1.5 w-1.5 rounded-full bg-neon shadow-[0_0_8px_#ff4fd8]" aria-hidden="true"></span>}
                {sub && <svg class="h-3 w-3 opacity-60 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/></svg>}
              </a>
              {isActive(item.href) && <span class="absolute inset-x-4 -bottom-0.5 h-px bg-gradient-to-r from-vision to-signal" aria-hidden="true" />}
              {sub && (
                <div class="invisible absolute left-1/2 top-full w-[22rem] -translate-x-1/2 pt-3 opacity-0 transition-all duration-300 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                  <ul class="glass rounded-2xl p-2 shadow-2xl shadow-black/50">
                    {sub.map((s) => (
                      <li>
                        <a href={s.href} class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-mist-200 transition-colors hover:bg-white/5 hover:text-mist-50">
                          {s.icon && <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-signal-soft"><Icon name={s.icon} class="h-4 w-4" /></span>}
                          {s.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact/" class="btn btn-primary hidden !min-h-10 whitespace-nowrap !px-4 !py-2.5 sm:inline-flex xl:!px-5">Start a project <Arrow /></a>
      <button
        type="button"
        class="relative z-10 inline-flex h-11 w-11 items-center justify-center rounded-full border border-line-strong lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only">Open menu</span>
        <span class="relative block h-3 w-5" aria-hidden="true">
          <span class="absolute left-0 top-0 h-px w-5 bg-mist-50 transition-transform duration-300" data-bar="1"></span>
          <span class="absolute bottom-0 left-0 h-px w-5 bg-mist-50 transition-transform duration-300" data-bar="2"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="fixed inset-0 z-40 hidden overflow-y-auto bg-void/95 pt-[var(--header-h)] backdrop-blur-xl lg:hidden" data-menu>
    <nav aria-label="Mobile" class="container-x py-8">
      <ul class="space-y-1">
        {navigation.map((item) => (
          <li class="border-b border-line py-3">
            <a href={item.href} class="font-display text-3xl text-mist-50">{item.label}</a>
            {menus[item.href] && (
              <ul class="mt-3 grid gap-2 pb-1">
                {menus[item.href].map((s) => (
                  <li><a href={s.href} class="text-[0.95rem] text-mist-400">{s.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
        <li class="py-3"><a href="/contact/" class="font-display text-3xl text-mist-50">Contact</a></li>
      </ul>
      <a href="/contact/" class="btn btn-primary mt-8 w-full">Start a project <Arrow /></a>
    </nav>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const bars = toggle.querySelectorAll<HTMLElement>('[data-bar]');

  const onScroll = () => {
    const scrolled = window.scrollY > 24;
    header.classList.toggle('is-scrolled', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
    menu.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
    bars[0].style.transform = open ? 'translateY(5.5px) rotate(45deg)' : '';
    bars[1].style.transform = open ? 'translateY(-5.5px) rotate(-45deg)' : '';
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
