---
import Wordmark from '../ui/Wordmark.astro';
import Placeholder from '../ui/Placeholder.astro';
import { site } from '../../data/site';
import { capabilities, advisory } from '../../data/capabilities';
import { industries } from '../../data/industries';
const year = new Date().getFullYear();
---
<footer class="site-footer relative z-10 mt-24 overflow-hidden">
  <!-- Bot trap: invisible to people and assistive tech; disallowed for well-behaved crawlers via robots.txt -->
  <a href="/api/trap.php" class="bt-link" tabindex="-1" aria-hidden="true" rel="nofollow noindex">Archive</a>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="neon-grid !bottom-[-20%] !h-[90%] !opacity-40"></div>
    <div class="absolute -left-40 top-0 h-96 w-96 rounded-full bg-vision/30 blur-[120px]"></div>
    <div class="absolute -right-32 bottom-0 h-96 w-96 rounded-full bg-neon/20 blur-[120px]"></div>
    <div class="absolute left-1/3 top-1/3 h-72 w-72 rounded-full bg-signal/15 blur-[110px]"></div>
    <p class="footer-mark absolute -bottom-6 left-1/2 -translate-x-1/2 whitespace-nowrap font-display text-[19vw] font-semibold leading-none tracking-tight">INVICTUS</p>
  </div>
  <div class="container-x grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-4">
      <Wordmark id="ftr" />
      <p class="mt-6 max-w-xs font-display text-xl text-mist-50">Where vision becomes reality.</p>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-mist-400">
        AI and agents, SEO · AEO · GEO, websites, apps and SaaS, analytics, cloud and security, growth and consulting — from Kikinda, Serbia, for clients worldwide.
      </p>
      <div class="mt-6 space-y-2 text-sm" data-copy-ok>
        <a href="/contact/" class="link-underline inline-block py-1.5 text-mist-200">Send us a message →</a>
        {site.contact.phones.map((p) => (
          <div><a href={`tel:${p.tel}`} class="inline-block py-1.5 text-mist-400 hover:text-mist-200">{p.display}</a> <span class="text-xs text-mist-500">· {p.label}</span></div>
        ))}
        {site.contact.emailIsPlaceholder && <div><Placeholder label="public contact email" /></div>}
      </div>
    </div>

    <nav aria-label="Capabilities" class="md:col-span-3">
      <h2 class="font-mono text-xs uppercase tracking-[0.18em] text-mist-500">Capabilities</h2>
      <ul class="mt-5 space-y-3 text-sm">
        {capabilities.map((c) => <li><a href={`/capabilities/${c.slug}/`} class="text-mist-200 hover:text-mist-50">{c.name}</a></li>)}
        <li><a href="/approach/#advisory" class="text-mist-200 hover:text-mist-50">{advisory.name}</a></li>
      </ul>
    </nav>

    <nav aria-label="Company" class="md:col-span-2">
      <h2 class="font-mono text-xs uppercase tracking-[0.18em] text-mist-500">Explore</h2>
      <ul class="mt-5 space-y-3 text-sm">
        {industries.map((i) => <li><a href={`/industries/${i.slug}/`} class="text-mist-200 hover:text-mist-50">{i.shortName}</a></li>)}
        <li><a href="/ai-agents/" class="text-mist-200 hover:text-mist-50">AI agent workforce</a></li>
        <li><a href="/tools/" class="text-mist-200 hover:text-mist-50">Free tools</a></li>
        <li><a href="/insights/" class="text-mist-200 hover:text-mist-50">Insights</a></li>
        <li><a href="/products/" class="text-mist-200 hover:text-mist-50">Products</a></li>
        <li><a href="/approach/" class="text-mist-200 hover:text-mist-50">Approach</a></li>
        <li><a href="/contact/" class="text-mist-200 hover:text-mist-50">Contact</a></li>
      </ul>
    </nav>

    <div class="md:col-span-3">
      <h2 class="font-mono text-xs uppercase tracking-[0.18em] text-mist-500">Start a conversation</h2>
      <p class="mt-5 text-sm leading-relaxed text-mist-400">Tell us what you want to build or improve. We reply to every serious inquiry.</p>
      <a href="/contact/" class="btn btn-ghost mt-5">Project inquiry</a>
      {site.social.length > 0 && (
        <ul class="mt-6 flex gap-4 text-sm">
          {site.social.map((s) => <li><a href={s.href} rel="noopener" class="text-mist-200 hover:text-mist-50">{s.label}</a></li>)}
        </ul>
      )}
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-x flex flex-col gap-3 py-6 text-xs text-mist-500 md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.legal.isPlaceholder ? site.name : site.legal.entityName}. All rights reserved.</p>
      <ul class="flex gap-6">
        <li><a href="/privacy/" class="hover:text-mist-200">Privacy</a></li>
        <li><a href="/legal/" class="hover:text-mist-200">Legal notice</a></li>
        <li><button type="button" class="hover:text-mist-200" data-cookie-settings>Cookie settings</button></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(180deg, rgb(10 14 28 / 0.6), rgb(5 6 10 / 0.78));
    border-top: 1px solid rgb(255 255 255 / 0.1);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07), 0 -20px 60px -30px rgb(124 92 255 / 0.5);
  }
  .site-footer::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 1px; pointer-events: none;
    background: linear-gradient(90deg, transparent, #7c5cff, #ff4fd8, #22d3ee, transparent);
    box-shadow: 0 0 18px #ff4fd8;
  }
  .bt-link { position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  .footer-mark { color: transparent; -webkit-text-stroke: 1px rgb(169 150 255 / 0.18); }
  :global(.motion-ok) .footer-mark { animation: mark-glow 6s ease-in-out infinite; }
  @keyframes mark-glow { 50% { -webkit-text-stroke-color: rgb(255 79 216 / 0.3); filter: drop-shadow(0 0 12px rgb(255 79 216 / 0.25)); } }
  .site-footer > div:not(:first-child) { position: relative; }
</style>
