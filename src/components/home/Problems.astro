---
import SectionHeading from '../ui/SectionHeading.astro';
import { getCapability } from '../../data/capabilities';

const problems = [
  { title: 'Invisible in search and AI answers', text: 'Competitors show up on Google, in AI overviews and in ChatGPT — your business does not.', cap: 'search-visibility' },
  { title: 'Repetitive work that drains teams', text: 'Skilled people spend their time copying, checking and routing information.', cap: 'ai-automation' },
  { title: 'Tracking nobody trusts', text: 'GA4 numbers do not add up, consent is broken and reporting is done by hand.', cap: 'data-intelligence' },
  { title: 'A website or product that holds you back', text: 'Slow, outdated or impossible to extend — or the product you need does not exist yet.', cap: 'software-engineering' },
  { title: 'Security and compliance blind spots', text: 'No security review, risky deployments and uncertainty about GDPR.', cap: 'cloud-platform' },
  { title: 'Marketing you can’t measure', text: 'Budget goes out every month, but nobody can connect it to leads and revenue.', cap: 'digital-growth' },
];
---
<section class="relative py-28 md:py-36" data-scene="1" data-dim="0.32" data-offset="2.6" aria-label="Problems we solve">
  <div class="container-x">
    <SectionHeading eyebrow="Problems we solve" title="Most digital challenges are <span class='text-gradient'>structural</span>, not cosmetic." intro="Organisations rarely need more tools. They need the right systems, connected properly and built to last. These are the problems we are most often asked to solve." />
    <ul class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {problems.map((p, i) => {
        const cap = getCapability(p.cap)!;
        return (
          <li class="group relative bg-ink-900/85 p-8 backdrop-blur-sm transition-colors hover:bg-ink-800/90" data-reveal data-reveal-delay={i * 70}>
            <span class="font-mono text-xs text-mist-500">0{i + 1}</span>
            <h3 class="mt-5 text-xl">{p.title}</h3>
            <p class="mt-3 text-mist-400">{p.text}</p>
            <a href={`/capabilities/${cap.slug}/`} class="mt-6 inline-flex items-center gap-2 text-sm text-signal-soft after:absolute after:inset-0">
              <span class="link-underline">{cap.name}</span>
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
