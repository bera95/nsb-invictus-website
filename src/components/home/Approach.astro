---
import SectionHeading from '../ui/SectionHeading.astro';
import { process } from '../../data/approach';
---
<section class="relative py-28 md:py-36" data-scene="4" data-dim="0.22" data-offset="0" aria-labelledby="approach-title">
  <div class="container-x">
    <SectionHeading eyebrow="How we work" title="A clear path from idea to <span class='text-gradient'>working system</span>." intro="Every engagement follows the same disciplined arc. It keeps scope visible, risk low and decisions grounded in evidence — whether we are building an MVP or modernising an enterprise platform." />
    <ol class="relative mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      <span class="absolute left-0 right-0 top-[1.4rem] hidden h-px bg-gradient-to-r from-vision via-signal to-reality opacity-50 lg:block" aria-hidden="true"></span>
      {process.map((s, i) => (
        <li class="relative" data-reveal data-reveal-delay={i * 90}>
          <span class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full border border-line-strong bg-ink-900 font-mono text-xs text-mist-50">{s.n}</span>
          <h3 class="mt-6 text-2xl">{s.title}</h3>
          <p class="mt-3 text-mist-400">{s.text}</p>
          <ul class="mt-4 space-y-1.5 text-sm text-mist-500">
            {s.outputs.map((o) => <li>— {o}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>
