---
import Arrow from '../ui/Arrow.astro';
import { advisory } from '../../data/capabilities';
---
<section class="relative py-10" aria-labelledby="advisory-title">
  <div class="container-x">
    <div class="glass relative overflow-hidden rounded-3xl p-8 sm:p-12" data-reveal>
      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-vision/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-center">
        <div>
          <p class="eyebrow mb-5">Where most projects start</p>
          <h2 id="advisory-title" class="text-3xl sm:text-4xl">{advisory.name}</h2>
          <p class="mt-5 max-w-xl leading-relaxed text-mist-400">{advisory.summary}</p>
          <a href="/contact/?topic=advisory" class="btn btn-primary mt-8">Book a discovery consultation <Arrow /></a>
        </div>
        <ol class="grid gap-3 sm:grid-cols-2">
          {advisory.steps.map((s, i) => (
            <li class="rounded-2xl border border-line bg-void/40 p-5">
              <span class="font-mono text-xs text-signal-soft">0{i + 1}</span>
              <p class="mt-2 text-mist-50">{s}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
