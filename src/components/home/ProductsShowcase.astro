---
import Arrow from '../ui/Arrow.astro';
import ProductGrid from '../ui/ProductGrid.astro';
---
<section class="relative py-28 md:py-36" data-scene="2" data-dim="0.12" data-offset="0" aria-labelledby="products-title">
  <div class="container-x">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-end">
      <div data-reveal>
        <p class="eyebrow mb-5">Proprietary tools</p>
        <h2 id="products-title" class="text-display-md">Our own platforms. <span class="text-gradient">Your unfair advantage.</span></h2>
      </div>
      <p class="max-w-xl text-lg leading-relaxed text-mist-400 lg:justify-self-end" data-reveal>
        Our team builds and runs its own tools for search intelligence and live analytics. We use them in client work every day — so audits are deeper, monitoring is continuous and problems are found before they cost you.
      </p>
    </div>
    <div class="mt-14"><ProductGrid /></div>
    <a href="/products/" class="btn btn-ghost mt-10">Explore our tools <Arrow /></a>
  </div>
</section>
