---
import Arrow from '../ui/Arrow.astro';
import { industries } from '../../data/industries';
const prop = industries.find((i) => i.flagship)!;
const others = industries.filter((i) => !i.flagship);
---
<section class="relative py-28 md:py-40" data-scene="3" data-dim="1" data-offset="2.3" aria-labelledby="prop-title">
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(90deg,rgba(5,6,10,0.92)_0%,rgba(5,6,10,0.75)_45%,transparent_75%)] lg:block" aria-hidden="true"></div>
  <div class="container-x relative">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow mb-5">Industry focus · {prop.shortName}</p>
      <h2 id="prop-title" class="text-display-md">{prop.headline}</h2>
      <p class="mt-6 text-lg leading-relaxed text-mist-400">{prop.summary}</p>
    </div>
    <ul class="mt-12 grid max-w-2xl gap-x-8 gap-y-6 sm:grid-cols-2">
      {prop.solutions.map((s, i) => (
        <li class="border-t border-line pt-5" data-reveal data-reveal-delay={i * 60}>
          <h3 class="text-lg">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-mist-400">{s.text}</p>
        </li>
      ))}
    </ul>
    <div class="mt-12 flex flex-wrap gap-3" data-reveal>
      <a href={`/industries/${prop.slug}/`} class="btn btn-primary">Explore Property Technology <Arrow /></a>
      {others.map((o) => <a href={`/industries/${o.slug}/`} class="btn btn-ghost">{o.shortName}</a>)}
    </div>
  </div>
</section>
